<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>two_Fingers_No_Skill.tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CS8981: the project naming convention allows all-lowercase type names. -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\two_Fingers_No_Skill\two_Fingers_No_Skill.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped settings file, so tests can check it matches the code defaults. -->
    <None Include="..\..\src\two_Fingers_No_Skill\game_Settings.json" Link="game_Settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
