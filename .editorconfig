root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

[*.cs]
# The project uses its own naming convention (lower first word, then _Capitalised words),
# so the default .NET naming rules are disabled.
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none
